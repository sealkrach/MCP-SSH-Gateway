# ══════════════════════════════════════════════════════
# MCP SSH Gateway — Configuration
# Copier en .env et remplir les valeurs
# ══════════════════════════════════════════════════════

# ── Sécurité JWT ─────────────────────────────────────
# OBLIGATOIRE — le gateway refuse de démarrer sans un secret d'au moins
# 32 caractères. Générer avec :  openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRE_HOURS=24

# ── Utilisateurs ──────────────────────────────────────
# Créer users.json (ou GATEWAY_USERS) avec des hash bcrypt :
#   python -m gateway.hash_password
#   [{"username":"admin","password_hash":"$2b$12$...","roles":["admin"]}]
# true = comptes de démo admin/admin123… (dev local UNIQUEMENT)
ALLOW_DEFAULT_USERS=false

# ── Base de données ───────────────────────────────────
DB_PASSWORD=supersecret

# ── SSH ───────────────────────────────────────────────
# "key"      = clé statique ~/.ssh/id_rsa  (dev)
# "vault"    = certificats éphémères       (prod, HashiCorp Vault SSH CA)
# "vault-kv" = clé stockée dans Vault KV  (prod, HashiCorp Vault KV)
# "cyberark" = credentials depuis CyberArk PAM
SSH_MODE=key
# SSH_KEY_PATH=~/.ssh/id_rsa          # chemin si mode key

# Vérification des clés d'hôte SSH (anti-MITM) :
# "strict"   = host_key requis pour chaque hôte (défaut du code, recommandé prod)
# "tofu"     = épinglage automatique au premier exec (défaut docker-compose)
# "insecure" = aucune vérification (dev local uniquement)
SSH_HOST_KEY_POLICY=tofu

# ── Vault (si SSH_MODE=vault ou vault-kv) ────────────
# VAULT_URL=https://vault.internal:8200
# VAULT_TOKEN=s.XXXXXXXXXXXXX
# VAULT_MOUNT=ssh

# ── CyberArk (si SSH_MODE=cyberark) ──────────────────
# CYBERARK_URL=https://cyberark.company.com
# CYBERARK_MODE=ccp                    # ccp (Central Credential Provider) | pvwa (PVWA REST)
# CYBERARK_APP_ID=MCP_SSH_Gateway      # Identifiant application CCP
# CYBERARK_DEFAULT_SAFE=SSH_Keys_Safe  # Safe par défaut (si vault_role sans '/')
# CYBERARK_VERIFY_SSL=true             # Vérification TLS (false pour CA interne non configuré)
# CYBERARK_CA_CERT=                    # /path/to/ca-bundle.pem (CA d'entreprise)
# CYBERARK_CLIENT_CERT=                # /path/to/client.crt (mTLS, CCP uniquement)
# CYBERARK_CLIENT_KEY=                 # /path/to/client.key  (mTLS, CCP uniquement)
# CYBERARK_USERNAME=svc_mcp_gateway    # Compte service (PVWA uniquement)
# CYBERARK_PASSWORD=XXXX               # Mot de passe service (PVWA uniquement)
# CYBERARK_AUTH_METHOD=ldap            # Méthode auth PVWA : ldap | radius | cyberark | windows
# CYBERARK_SESSION_TIMEOUT=1200        # TTL session PVWA en secondes (défaut : 20 min)

# ── Policies ──────────────────────────────────────────
# "deny"  = allow-list en production : toute commande sans règle `allow` est refusée (recommandé)
# "allow" = ancien comportement fail-open (les règles deny restent appliquées)
POLICY_PROD_DEFAULT=deny

# ── CORS ──────────────────────────────────────────────
# Vide = pas de CORS (UI servie par le gateway = même origine, rien à faire).
# Si l'UI est hébergée ailleurs : CORS_ORIGINS=https://ui.example.com
CORS_ORIGINS=

# ── Anti brute-force login ────────────────────────────
# LOGIN_MAX_FAILS=5           # tentatives avant verrouillage (par user+IP)
# LOGIN_MAX_FAILS_USER=20     # seuil global par user (contre le spoof d'IP/XFF)
# LOGIN_LOCKOUT_SECONDS=900   # durée du verrouillage

# ── Rate limits (commandes/minute) ───────────────────
RATE_PROD=10
RATE_STG=30
RATE_DEV=100

# ── Ports ─────────────────────────────────────────────
GATEWAY_PORT=8080
UI_PORT=3000
GRAFANA_PORT=3001

# ── Grafana ───────────────────────────────────────────
GRAFANA_PASSWORD=admin

# ── Logs ──────────────────────────────────────────────
LOG_LEVEL=info
