# ══════════════════════════════════════════════════════
# MCP SSH Gateway — Configuration
# Copier en .env et remplir les valeurs
# ══════════════════════════════════════════════════════

# ── Sécurité JWT ─────────────────────────────────────
JWT_SECRET=CHANGE-ME-minimum-32-characters-secret
JWT_EXPIRE_HOURS=24

# ── Base de données ───────────────────────────────────
DB_PASSWORD=supersecret

# ── SSH ───────────────────────────────────────────────
# "key"      = clé statique ~/.ssh/id_rsa  (dev)
# "vault"    = certificats éphémères       (prod, HashiCorp Vault SSH CA)
# "vault-kv" = clé stockée dans Vault KV  (prod, HashiCorp Vault KV)
# "cyberark" = credentials depuis CyberArk PAM
SSH_MODE=key
# SSH_KEY_PATH=~/.ssh/id_rsa          # chemin si mode key

# ── Vault (si SSH_MODE=vault ou vault-kv) ────────────
# VAULT_URL=https://vault.internal:8200
# VAULT_TOKEN=s.XXXXXXXXXXXXX
# VAULT_MOUNT=ssh

# ── CyberArk (si SSH_MODE=cyberark) ──────────────────
# CYBERARK_URL=https://cyberark.company.com
# CYBERARK_MODE=ccp                    # ccp (Central Credential Provider) | pvwa (PVWA REST)
# CYBERARK_APP_ID=MCP_SSH_Gateway      # Identifiant application CCP
# CYBERARK_DEFAULT_SAFE=SSH_Keys_Safe  # Safe par défaut (si vault_role sans '/')
# CYBERARK_VERIFY_SSL=true             # Vérification TLS (false pour CA interne non configuré)
# CYBERARK_CA_CERT=                    # /path/to/ca-bundle.pem (CA d'entreprise)
# CYBERARK_CLIENT_CERT=                # /path/to/client.crt (mTLS, CCP uniquement)
# CYBERARK_CLIENT_KEY=                 # /path/to/client.key  (mTLS, CCP uniquement)
# CYBERARK_USERNAME=svc_mcp_gateway    # Compte service (PVWA uniquement)
# CYBERARK_PASSWORD=XXXX               # Mot de passe service (PVWA uniquement)
# CYBERARK_AUTH_METHOD=ldap            # Méthode auth PVWA : ldap | radius | cyberark | windows
# CYBERARK_SESSION_TIMEOUT=1200        # TTL session PVWA en secondes (défaut : 20 min)

# ── Rate limits (commandes/minute) ───────────────────
RATE_PROD=10
RATE_STG=30
RATE_DEV=100

# ── Ports ─────────────────────────────────────────────
GATEWAY_PORT=8080
UI_PORT=3000
GRAFANA_PORT=3001

# ── Grafana ───────────────────────────────────────────
GRAFANA_PASSWORD=admin

# ── Logs ──────────────────────────────────────────────
LOG_LEVEL=info
